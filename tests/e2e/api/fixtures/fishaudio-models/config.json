{
  "$schema": "https://www.getbifrost.ai/schema",
  "providers": {
    "fishaudio": {
      "keys": [
        {
          "name": "Fish Audio model-list fixture",
          "value": "unused-model-list-fixture-key",
          "models": ["*"],
          "weight": 1
        }
      ],
      "network_config": {
        "base_url": "http://127.0.0.1:1",
        "default_request_timeout_in_seconds": 1,
        "max_retries": 0
      }
    }
  }
}
